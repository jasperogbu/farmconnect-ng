# ---------------------------------------------------------------------------
# FarmConnect NG - example environment configuration
# Copy to `.env` at the project root and fill in real values.
# A single .env serves both the backend (pydantic-settings) and the frontend
# (Vite). Only variables prefixed with VITE_ are exposed to the browser bundle.
# `.env` is gitignored - never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application (backend) ---
APP_NAME="FarmConnect NG"
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (SQLite by default; path is relative to the backend directory) ---
DATABASE_URL=sqlite:///./farmconnect.db

# --- CORS: the frontend origin allowed to call the API ---
FRONTEND_URL=http://localhost:5173

# --- Bootstrap administrator ---
# Public sign-up can only create farmers and buyers. The first administrator is
# created automatically on startup from the values below (change them in
# production). An existing account with this username is promoted to admin.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_FULL_NAME=admin

# --- Uploads ---
MAX_UPLOAD_MB=5
# Optional absolute path for uploaded images (e.g. a mounted disk on Render).
# Leave empty to use <backend>/uploads.
UPLOAD_DIR=

# --- Frontend (Vite) ---
# Leave empty in development: the Vite dev server proxies /api and /uploads to
# http://localhost:8000. In production set this to your API base URL, e.g.
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=
